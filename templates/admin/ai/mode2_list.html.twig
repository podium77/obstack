{% extends "base.html.twig" %}

{% block title %}Déploiements Mode 2{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>
                <i class="fa fa-list"></i> Déploiements Mode 2
            </h1>
            <p class="text-muted">Gestion des déploiements automatisés</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_ai_dashboard') }}" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Retour au Dashboard
            </a>
        </div>
    </div>

    {% if deployments|length > 0 %}
        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fa fa-boxes"></i> 
                    Tous les déploiements ({{ deployments|length }})
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom du Déploiement</th>
                            <th>Hyperviseur</th>
                            <th>Machine Virtuelle</th>
                            <th>Modèle</th>
                            <th>Statut</th>
                            <th>IP</th>
                            <th>Créé</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for deployment in deployments %}
                            <tr>
                                <td>
                                    <strong>{{ deployment.name }}</strong>
                                    {% if deployment.company %}
                                        <br><small class="text-muted">{{ deployment.company.name }}</small>
                                    {% else %}
                                        <br><small class="badge bg-success">Global</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ deployment.hypervisorProvider|upper }}</span>
                                </td>
                                <td>
                                    {% if deployment.vmConfig.name %}
                                        <code class="text-break" style="font-size: 0.85rem;">
                                            {{ deployment.vmConfig.name }}
                                        </code>
                                    {% else %}
                                        <small class="text-muted">-</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-secondary">{{ deployment.aiModel }}</span>
                                </td>
                                <td>
                                    {% if deployment.status == 'pending' %}
                                        <span class="badge bg-secondary">
                                            <i class="fa fa-hourglass-start"></i> En attente
                                        </span>
                                    {% elseif deployment.status == 'deploying' %}
                                        <span class="badge bg-warning">
                                            <i class="fa fa-spinner fa-spin"></i> Déploiement
                                        </span>
                                    {% elseif deployment.status == 'configuring' %}
                                        <span class="badge bg-info">
                                            <i class="fa fa-cog fa-spin"></i> Configuration
                                        </span>
                                    {% elseif deployment.status == 'deployed' %}
                                        <span class="badge bg-success">
                                            <i class="fa fa-check-circle"></i> Succès
                                        </span>
                                    {% elseif deployment.status == 'failed' %}
                                        <span class="badge bg-danger">
                                            <i class="fa fa-exclamation-circle"></i> Erreur
                                        </span>
                                    {% elseif deployment.status == 'stopping' %}
                                        <span class="badge bg-warning">
                                            <i class="fa fa-power-off"></i> Arrêt
                                        </span>
                                    {% elseif deployment.status == 'stopped' %}
                                        <span class="badge bg-secondary">
                                            <i class="fa fa-power-off"></i> Arrêté
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ deployment.status }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if deployment.vmIp %}
                                        <code>{{ deployment.vmIp }}</code>
                                    {% else %}
                                        <small class="text-muted">-</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <small class="text-muted">
                                        {{ deployment.createdAt|date('d/m/Y H:i') }}
                                    </small>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('admin_ai_mode2_status', {id: deployment.id}) }}" 
                                           class="btn btn-outline-primary" title="Voir détails">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        {% if deployment.status in ['pending', 'deploying', 'configuring'] %}
                                            <form method="POST" 
                                                  action="{{ path('admin_ai_mode2_cancel', {id: deployment.id}) }}"
                                                  style="display: inline;">
                                                <button type="submit" class="btn btn-outline-warning btn-sm"
                                                        title="Annuler">
                                                    <i class="fa fa-stop"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if deployment.status in ['failed', 'stopped', 'deployed'] %}
                                            <form method="POST" 
                                                  action="{{ path('admin_ai_mode2_delete', {id: deployment.id}) }}"
                                                  onsubmit="return confirm('Êtes-vous sûr ?');"
                                                  style="display: inline;">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        title="Supprimer">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">
                <i class="fa fa-info-circle"></i> Aucun Déploiement Mode 2
            </h4>
            <p>
                Aucun déploiement automatisé (Mode 2) n'a été lancé. 
                Mode 2 vous permet de déployer l'IA automatiquement sur vos hyperviseurs.
            </p>
            <hr>
            <a href="{{ path('admin_ai_mode2_wizard') }}" class="btn btn-primary">
                <i class="fa fa-rocket"></i> Lancer un nouveau déploiement
            </a>
            <a href="{{ path('admin_ai_dashboard') }}" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Retour au Dashboard
            </a>
        </div>
    {% endif %}

    <!-- Info Section -->
    <div class="row mt-5">
        <div class="col-lg-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="fa fa-rocket"></i> Mode 2 — Déploiement Automatisé
                    </h6>
                    <p class="card-text small mb-0">
                        Déploiement automatique d'Ollama sur votre infrastructure hyperviseur 
                        (Proxmox, VMware, Nutanix). Les ressources VM (CPU, RAM, Disk) sont 
                        automatiquement dimensionnées selon vos besoins.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">
                        <i class="fa fa-list-check"></i> États du Déploiement
                    </h6>
                    <ul class="small mb-0 ps-3">
                        <li><strong>Pending:</strong> En attente de traitement</li>
                        <li><strong>Deploying:</strong> Création de la VM en cours</li>
                        <li><strong>Configuring:</strong> Installation et configuration</li>
                        <li><strong>Deployed:</strong> Succès - Infrastructure opérationnelle</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.btn-group-sm .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
}

code {
    background-color: #f5f5f5;
    padding: 2px 4px;
    border-radius: 3px;
    font-size: 0.85rem;
}
</style>
{% endblock %}
