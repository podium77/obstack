{% extends "base.html.twig" %}

{% block title %}État du Déploiement - Mode 2{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>
                <i class="fa fa-rocket"></i> Déploiement Mode 2 en cours
            </h1>
            <p class="text-muted">{{ deployment.name }}</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_ai_mode2_list') }}" class="btn btn-secondary">
                <i class="fa fa-list"></i> Liste des déploiements
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Progress Bar -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">Progression</h6>
                        <small id="progress-percent">0%</small>
                    </div>
                    <div class="progress" style="height: 25px;">
                        <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" 
                             role="progressbar" style="width: 0%;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">État du déploiement</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="status-box">
                                <i class="fa fa-box fa-2x mb-2" id="vm-icon"></i>
                                <p class="small">Machine Virtuelle</p>
                                <span id="vm-status" class="badge bg-secondary">-</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="status-box">
                                <i class="fa fa-download fa-2x mb-2" id="ollama-icon"></i>
                                <p class="small">Ollama</p>
                                <span id="ollama-status" class="badge bg-secondary">-</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="status-box">
                                <i class="fa fa-brain fa-2x mb-2" id="model-icon"></i>
                                <p class="small">Modèle {{ deployment.aiModel }}</p>
                                <span id="model-status" class="badge bg-secondary">-</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Logs -->
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fa fa-list"></i> Logs de déploiement
                    </h5>
                </div>
                <div class="card-body" style="max-height: 400px; overflow-y: auto; background-color: #f8f9fa;">
                    <div id="deployment-logs" class="font-monospace small">
                        {% for log in deployment.deploymentLog %}
                            <div class="log-entry">
                                <small class="text-muted">{{ log.timestamp }}</small>
                                <span>{{ log.message }}</span>
                            </div>
                        {% else %}
                            <small class="text-muted">En attente de logs...</small>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Deployment Info -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Informations</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td><strong>Statut</strong></td>
                                <td id="status-badge">
                                    {% if deployment.status == 'pending' %}
                                        <span class="badge bg-secondary">En attente</span>
                                    {% elseif deployment.status == 'deploying' %}
                                        <span class="badge bg-warning">Déploiement</span>
                                    {% elseif deployment.status == 'configuring' %}
                                        <span class="badge bg-info">Configuration</span>
                                    {% elseif deployment.status == 'deployed' %}
                                        <span class="badge bg-success">Succès ✓</span>
                                    {% elseif deployment.status == 'failed' %}
                                        <span class="badge bg-danger">Erreur</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ deployment.status }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Hyperviseur</strong></td>
                                <td>{{ deployment.hypervisorProvider|upper }}</td>
                            </tr>
                            <tr>
                                <td><strong>VM</strong></td>
                                <td>
                                    {% if deployment.vmId %}
                                        <code>{{ deployment.vmId }}</code>
                                    {% else %}
                                        <small class="text-muted">-</small>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td><strong>IP</strong></td>
                                <td>
                                    {% if deployment.vmIp %}
                                        <code>{{ deployment.vmIp }}</code>
                                    {% else %}
                                        <small class="text-muted">-</small>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Créé</strong></td>
                                <td>{{ deployment.createdAt|date('d/m/Y H:i') }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- VM Config Summary -->
            <div class="card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fa fa-microchip"></i> Configuration VM</h5>
                </div>
                <div class="card-body small">
                    {% set vmConfig = deployment.vmConfig %}
                    <p class="mb-1">
                        <strong>Nom:</strong> {{ vmConfig.name }}
                    </p>
                    <p class="mb-1">
                        <strong>CPU:</strong> {{ vmConfig.cores }}
                    </p>
                    <p class="mb-1">
                        <strong>RAM:</strong> {{ (vmConfig.memory/1024)|round(1) }} GB
                    </p>
                    <p class="mb-0">
                        <strong>Disk:</strong> {{ vmConfig.disk_size }} GB
                    </p>
                </div>
            </div>

            <!-- Actions -->
            <div class="card mb-4" id="actions-card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        {% if deployment.status in ['pending', 'deploying', 'configuring'] %}
                            <form method="POST" action="{{ path('admin_ai_mode2_cancel', {id: deployment.id}) }}">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fa fa-stop"></i> Annuler
                                </button>
                            </form>
                        {% elseif deployment.status == 'deployed' %}
                            <a href="{{ path('admin_ai_dashboard') }}" class="btn btn-success">
                                <i class="fa fa-check"></i> Voir Infrastructure
                            </a>
                        {% endif %}
                        
                        {% if deployment.status in ['failed', 'stopped', 'deployed'] %}
                            <form method="POST" action="{{ path('admin_ai_mode2_delete', {id: deployment.id}) }}" 
                                  onsubmit="return confirm('Êtes-vous sûr ?');">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="fa fa-trash"></i> Supprimer
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Error Panel -->
            {% if deployment.errorMessage %}
                <div class="alert alert-danger" role="alert">
                    <h6 class="alert-heading">
                        <i class="fa fa-exclamation-circle"></i> Erreur
                    </h6>
                    {{ deployment.errorMessage }}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.status-box {
    padding: 15px;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background-color: #f8f9fa;
}

.log-entry {
    padding: 5px 0;
    border-bottom: 1px solid #e9ecef;
}

.log-entry:last-child {
    border-bottom: none;
}

.table-borderless td {
    padding: 0.5rem 0;
    border: none;
}

.progress-bar-animated {
    animation: progress-bar-stripes 1s linear infinite;
}

#deployment-logs {
    font-family: 'Monaco', 'Menlo', 'Courier New', monospace;
    line-height: 1.5;
    color: #333;
}
</style>

<script>
const deploymentId = {{ deployment.id }};
let isComplete = false;

// Update status every 2 seconds
setInterval(() => {
    if (isComplete) return;

    fetch(`{{ path('admin_ai_mode2_status_json', {id: deployment.id}) }}`)
        .then(response => response.json())
        .then(data => {
            // Update progress
            const progress = data.progress || 0;
            document.getElementById('progress-bar').style.width = progress + '%';
            document.getElementById('progress-percent').textContent = progress + '%';

            // Update status badge
            updateStatusBadge(data.status);

            // Update logs
            updateLogs(data.log);

            // Update VM IP
            if (data.vm_ip) {
                document.querySelector('td code').textContent = data.vm_ip;
            }

            // Check if complete
            if (['deployed', 'failed', 'stopped'].includes(data.status)) {
                isComplete = true;
                if (data.status === 'deployed') {
                    showSuccess();
                } else if (data.status === 'failed') {
                    showError(data.error);
                }
            }
        })
        .catch(error => console.error('Error:', error));
}, 2000);

function updateStatusBadge(status) {
    const badge = document.getElementById('status-badge');
    let html = '';
    
    switch(status) {
        case 'pending':
            html = '<span class="badge bg-secondary">En attente</span>';
            break;
        case 'deploying':
            html = '<span class="badge bg-warning"><i class="fa fa-spinner fa-spin"></i> Déploiement</span>';
            break;
        case 'configuring':
            html = '<span class="badge bg-info"><i class="fa fa-spinner fa-spin"></i> Configuration</span>';
            break;
        case 'deployed':
            html = '<span class="badge bg-success">Succès ✓</span>';
            break;
        case 'failed':
            html = '<span class="badge bg-danger">Erreur</span>';
            break;
    }
    
    badge.innerHTML = html;
}

function updateLogs(logs) {
    const logsDiv = document.getElementById('deployment-logs');
    let html = '';
    
    if (!logs || logs.length === 0) {
        html = '<small class="text-muted">En attente de logs...</small>';
    } else {
        logs.forEach(log => {
            html += `
                <div class="log-entry">
                    <small class="text-muted">${log.timestamp}</small>
                    <span>${escapeHtml(log.message)}</span>
                </div>
            `;
        });
    }
    
    logsDiv.innerHTML = html;
    logsDiv.scrollTop = logsDiv.scrollHeight;
}

function showSuccess() {
    const actionsCard = document.getElementById('actions-card');
    actionsCard.innerHTML = `
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="fa fa-check-circle"></i> Déploiement Réussi !</h5>
        </div>
        <div class="card-body">
            <p class="mb-3">Votre infrastructure IA Mode 2 est opérationnelle.</p>
            <div class="d-grid gap-2">
                <a href="{{ path('admin_ai_dashboard') }}" class="btn btn-success">
                    <i class="fa fa-arrow-right"></i> Aller au Dashboard
                </a>
            </div>
        </div>
    `;
}

function showError(errorMsg) {
    const actionsCard = document.getElementById('actions-card');
    actionsCard.innerHTML = `
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="fa fa-exclamation-circle"></i> Déploiement Échoué</h5>
        </div>
        <div class="card-body">
            <p class="small mb-3">${escapeHtml(errorMsg || 'Erreur inconnue')}</p>
            <div class="d-grid">
                <form method="POST" action="{{ path('admin_ai_mode2_delete', {id: deployment.id}) }}">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa fa-trash"></i> Supprimer ce déploiement
                    </button>
                </form>
            </div>
        </div>
    `;
}

function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>
{% endblock %}
